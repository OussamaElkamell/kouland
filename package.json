{
  "name": "kouland",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.10.1",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@kouland/api",
    "build:web": "turbo run build --filter=@kouland/web",
    "start:api": "pnpm --filter @kouland/api start:prod",
    "start:web": "pnpm --filter @kouland/web start",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @kouland/api prisma:migrate",
    "db:deploy": "pnpm --filter @kouland/api prisma:deploy"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
