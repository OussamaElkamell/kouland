# Copy the API values to apps/api/.env and the NEXT_PUBLIC_* values to apps/web/.env.local.

# --- apps/api ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/kouland_crm"
API_PORT=4100
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS="http://localhost:3100"
# Reverse proxies in front of the API (default: 1 in production, 0 in development).
# TRUST_PROXY=1

# Email (Brevo). Without BREVO_API_KEY emails are only written to the API log.
BREVO_API_KEY=""
# Must be a sender or domain verified in the Brevo account.
MAIL_FROM_EMAIL="noreply@kouland.com"
MAIL_FROM_NAME="Kouland Technology"
# Inbox that receives website contact messages.
CONTACT_INBOX_EMAIL="contact@koulandtechnology.com"
# Inbox that receives job applications, with the CV attached. Defaults to CONTACT_INBOX_EMAIL.
# CAREERS_INBOX_EMAIL="jobs@kouland.com"

# CRM sessions. The cookie is Secure when the request came over HTTPS (behind TRUST_PROXY); force it with
# COOKIE_SECURE=true|false. COOKIE_DOMAIN shares it with the website's domain (optional).
# COOKIE_SECURE=true
# COOKIE_DOMAIN=kouland.com
# Website address used in invitation and password emails (/admin/link). Defaults to the first CORS_ORIGINS entry.
# APP_URL="http://localhost:3100"

# Milestone 4. 32 random bytes (64 hex characters) that encrypt integration secrets: webhook secrets and mailbox
# tokens. Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATIONS_KEY=""
# The API's public address without /api, as platforms, Twilio, Google and Microsoft reach it.
PUBLIC_API_URL="http://localhost:4100"
# Twilio: calls and SMS on the company number. Leave empty to turn the phone off.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
# Google Workspace mailboxes (Gmail API). Leave empty to hide "Connect Google Workspace".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Microsoft 365 mailboxes (Microsoft Graph). Leave empty to hide "Connect Microsoft 365".
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Your Microsoft 365 tenant id limits sign-in to the company's accounts (default: any work account).
# MICROSOFT_TENANT_ID=""

# --- apps/web ---
NEXT_PUBLIC_API_URL="http://localhost:4100/api"
NEXT_PUBLIC_SITE_URL="http://localhost:3100"
# Staging on *.up.railway.app only: forward /backend/* to the API (see DEPLOY.md), with NEXT_PUBLIC_API_URL="/backend/api".
# API_PROXY_TARGET="http://localhost:4100"
