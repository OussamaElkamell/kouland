# Copy the API values to apps/api/.env and the NEXT_PUBLIC_* values to apps/web/.env.local.

# --- apps/api ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/kouland_crm"
API_PORT=4100
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS="http://localhost:3100"
# Reverse proxies in front of the API (default: 1 in production, 0 in development).
# TRUST_PROXY=1

# Email (Brevo). Without BREVO_API_KEY emails are only written to the API log.
BREVO_API_KEY=""
# Must be a sender or domain verified in the Brevo account.
MAIL_FROM_EMAIL="noreply@kouland.com"
MAIL_FROM_NAME="Kouland Technology"
# Inbox that receives website contact messages.
CONTACT_INBOX_EMAIL="contact@koulandtechnology.com"
# Inbox that receives job applications, with the CV attached. Defaults to CONTACT_INBOX_EMAIL.
# CAREERS_INBOX_EMAIL="jobs@kouland.com"

# CRM sessions. The cookie is Secure when the request came over HTTPS (behind TRUST_PROXY); force it with
# COOKIE_SECURE=true|false. COOKIE_DOMAIN shares it with the website's domain (optional).
# COOKIE_SECURE=true
# COOKIE_DOMAIN=kouland.com

# --- apps/web ---
NEXT_PUBLIC_API_URL="http://localhost:4100/api"
NEXT_PUBLIC_SITE_URL="http://localhost:3100"
